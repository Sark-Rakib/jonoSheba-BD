# --- MongoDB ---
# Local: mongodb://127.0.0.1:27017/jonosheba
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/jonosheba
MONGODB_URI=mongodb://127.0.0.1:27017/jonosheba

# --- Auth session ---
# Generate with: openssl rand -base64 32
# Must be at least 32 characters.
SESSION_SECRET=replace-with-a-random-32-char-base64-string

# --- App ---
# Canonical site URL (no trailing slash). Used for metadata/canonical/sitemap.
SITE_URL=http://localhost:3000

# --- Optional: seed script admin account ---
# If set, `npm run seed` creates/updates an admin with these credentials.
# If unset, a random password is generated and printed once.
ADMIN_SEED_EMAIL=admin@jonosheba.example
ADMIN_SEED_PASSWORD=
